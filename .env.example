# ==============================================================================
# ASTRA — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure these variables in your target deployment.
# NEVER commit real credentials, production connection strings, or service keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (Spring Boot)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
LOGGING_LEVEL_ORG_ASTRA=DEBUG
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Database Persistence (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Spring Boot datasource URL pointing to Supabase PostgreSQL (or local container in dev)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres_dev_password_placeholder
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Connection Pool Settings (HikariCP)
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=30000

# Flyway Migrations
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# ------------------------------------------------------------------------------
# Simulation Engine Settings
# ------------------------------------------------------------------------------
# Tick frequency for the simulation integrator in Hertz (ticks per second)
ASTRA_SIMULATION_TICK_RATE_HZ=10
# Telemetry broadcast interval in milliseconds (e.g., 200ms = 5Hz broadcast rate)
ASTRA_TELEMETRY_BROADCAST_INTERVAL_MS=200
# Initial time dilation factor (1.0 = real-time, 5.0 = 5x acceleration)
ASTRA_SIMULATION_INITIAL_TIME_DILATION=1.0

# ------------------------------------------------------------------------------
# NASA Public API Gateways
# ------------------------------------------------------------------------------
# NASA Image and Video Library base endpoint (Public REST, no API key required)
NASA_IMAGES_API_BASE_URL=https://images-api.nasa.gov

# NASA GIBS WMTS Base URL for Earth Observation tile layers
NASA_GIBS_WMTS_BASE_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best

# NASA api.nasa.gov endpoint (Optional / Fallback)
# DEMO_KEY is subject to 30 req/hr; supply registered key from api.nasa.gov for dev
NASA_API_PORTAL_BASE_URL=https://api.nasa.gov
NASA_API_KEY=DEMO_KEY

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Base API URL consumed by the Vite development server
VITE_API_BASE_URL=http://localhost:8080/api/v1
# WebSocket STOMP endpoint URL
VITE_WS_ENDPOINT_URL=ws://localhost:8080/ws/simulation

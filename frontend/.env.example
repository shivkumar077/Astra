# ASTRA Spacecraft Operations & Mission Simulation
# Frontend Environment Configuration Template

# Optional API base URL override for NASA Imagery Gateway and backend telemetry.
# Leave empty in local development to route requests through Vite's dev server proxy (/api/v1 -> http://localhost:8080).
# In containerized or split-host deployments, set to the backend origin, e.g. http://localhost:8080/api/v1
VITE_API_BASE_URL=

# Optional STOMP WebSocket endpoint URL override.
# In local development, leave empty to default to ws://localhost:8080/ws/simulation (or reverse-proxy /ws/simulation).
VITE_WS_ENDPOINT_URL=
